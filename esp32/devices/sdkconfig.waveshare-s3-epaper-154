# Waveshare ESP32-S3-ePaper-1.54 V2: ESP32-S3-PICO-1-N8R8 (8 MB quad flash,
# 8 MB octal PSRAM), a 1.54 inch 200x200 black and white e-paper (SSD1681-type
# controller) on SPI, an ES8311 codec, and the chip's own USB-Serial-JTAG.
# V1 boards (ESP32-S3FH4R2, 4 MB flash and 2 MB PSRAM) are too small. Load
# last, after sdkconfig.defaults (see README.md in this directory).
#
# Sources: Waveshare's V2 ESP-IDF examples
# (github.com/waveshareteam/ESP32-S3-ePaper-1.54, 02_Example/ESP-IDF/V2) for
# the pins and PSRAM mode; esptool flash-id on the board for the chip, flash
# and PSRAM.
#
# It overrides the ESP32-C5 assumptions in sdkconfig.defaults; C5-only options
# there are ignored for this target.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# No status LED: the e-paper shows a status screen. It also holds the battery
# switch (GPIO17) and powers the panel (GPIO6).
CONFIG_HOMEHUB_LED_BACKEND_WAVESHARE_EPAPER_154=y
# BOOT, active low: tap to set up, hold to talk, hold 5 s to reset. PWR
# (GPIO18) is not used yet.
CONFIG_HOMEHUB_BUTTON_GPIO=0
# Push-to-talk through the ES8311 codec, its mic and the speaker header.
CONFIG_HOMEHUB_VOICE=y
# Offline, the paddle is the setup button: a reset takes a deliberate 15 s
# hold, well past a long question, and the screen counts down the last 5.
CONFIG_HOMEHUB_BUTTON_RESET_HOLD_S=15

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# Octal PSRAM holds the 40 KB gray canvas and the two 5 KB panel frames.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_MODE_QUAD=n
CONFIG_SPIRAM_SPEED_80M=y
# The BLE controller already takes ~70 KB of internal RAM on the S3; keep the
# NimBLE host's allocations in PSRAM so pairing has room.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# ElevenLabs (spoken replies) sends GTS Root R1 cross-signed by GlobalSign
# Root CA, which the bundle no longer has; this checks the chain against GTS
# Root R1 instead, which it does. About 700 bytes of heap.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
